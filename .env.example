# Copy to .env and adjust. Never commit the real .env.

# --- Database ---
POSTGRES_USER=template
POSTGRES_PASSWORD=template
POSTGRES_DB=template

# --- Backend ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin1234
CORS_ORIGINS=http://localhost:3030
# Set to false in production: it also forces JWT_SECRET to be a real value.
DEBUG=true

# --- Frontend ---
NEXT_PUBLIC_SITE_URL=http://localhost:3030
